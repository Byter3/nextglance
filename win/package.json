{
  "name": "@nextspace/windows",
  "version": "0.6.18",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Your Nextcloud calendars, tasks and projects in one personal planner",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "desktop": "electron .",
    "start": "pnpm build && electron .",
    "package:win": "pnpm build && electron-builder --win portable",
    "package:dir": "pnpm build && electron-builder --win --dir"
  },
  "dependencies": {
    "@nextspace/core": "workspace:*",
    "@nextspace/nextcloud-node": "workspace:*"
  },
  "devDependencies": {
    "@nextspace/ui": "workspace:*",
    "@nextspace/contracts": "workspace:*",
    "vue": "^3.5.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.3.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.nextspace.workspace",
    "productName": "NextGlance",
    "buildVersion": "0.6.18.20",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE.md",
        "to": "NOTICE.md"
      },
      {
        "from": "../LICENSES/Apache-2.0.txt",
        "to": "LICENSES/Apache-2.0.txt"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "electron/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "NextGlance-${version}-Windows.exe"
    }
  }
}
