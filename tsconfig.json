{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "preserve", "resolveJsonModule": true,
    "esModuleInterop": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true, "checkJs": false, "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["win/src/**/*.ts", "packages/ui/src/**/*.ts", "packages/ui/src/**/*.vue", "packages/contracts/src/**/*.ts"]
}
