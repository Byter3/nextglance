{
  "name": "nextspace-workspace",
  "version": "0.6.17",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Local workspace for NextGlance clients and shared packages",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @nextspace/windows dev",
    "build": "pnpm --filter @nextspace/windows build",
    "test": "node --test tests/*.test.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "test:connected": "node tests/nextcloud-desktop-smoke.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:timeline": "node tests/timeline-ui.mjs",
    "test:scheduling": "node tests/scheduling-ui.mjs",
    "test:categories": "node tests/category-editor-ui.mjs",
    "test:focus": "node tests/calm-timeline-ui.mjs",
    "test:overview": "node tests/overview-split-ui.mjs",
    "test:interactions": "node tests/overview-interactions-ui.mjs",
    "desktop": "pnpm --filter @nextspace/windows desktop",
    "start": "pnpm --filter @nextspace/windows start",
    "package:win": "pnpm --filter @nextspace/windows package:win",
    "package:win:dir": "pnpm --filter @nextspace/windows package:dir",
    "test:editing": "node tests/timeline-manipulation-ui.mjs",
    "test:zoom": "node tests/time-scale-ui.mjs",
    "test:inspector": "node tests/inspector-ui.mjs",
    "test:instant": "node tests/instant-edits-ui.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@nextspace/contracts": "workspace:*",
    "@nextspace/core": "workspace:*",
    "@nextspace/nextcloud-client": "workspace:*",
    "@nextspace/nextcloud-node": "workspace:*",
    "@nextspace/ui": "workspace:*",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "agent-browser": "^0.38.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "ical.js": "^2.2.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.1.0"
  }
}
