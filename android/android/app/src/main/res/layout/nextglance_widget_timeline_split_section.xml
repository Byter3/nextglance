<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@id/widget_row"
    android:layout_width="match_parent" android:layout_height="16dp" android:orientation="horizontal" android:layoutDirection="ltr">
    <LinearLayout android:id="@id/widget_timeline_section_content" android:layout_width="120dp" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="locale">
        <ImageView android:id="@id/widget_row_icon" android:layout_width="8dp" android:layout_height="8dp"
            android:layout_marginEnd="5dp" android:src="@drawable/widget_icon_task" android:importantForAccessibility="no" />
        <TextView android:id="@id/widget_row_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@id/widget_row_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="4dp" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" />
    </LinearLayout>
    <ImageView android:id="@id/widget_timeline_bar" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:scaleType="fitCenter" android:importantForAccessibility="no" />
</LinearLayout>
