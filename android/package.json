{
  "name": "@nextspace/android",
  "version": "0.6.30",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "NextGlance Android client using Nextcloud Files single sign-on",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build && node scripts/headless-bundle.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "native:prepare": "node scripts/prepare-native.mjs && cap update android",
    "sync": "pnpm build && cap sync android",
    "open": "cap open android",
    "apk:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-debug.ps1",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/network": "8.0.1",
    "@nextspace/contracts": "workspace:*",
    "@nextspace/core": "workspace:*",
    "@nextspace/nextcloud-client": "workspace:*",
    "@nextspace/ui": "workspace:*",
    "fast-text-encoding": "1.0.6",
    "vue": "^3.5.0",
    "whatwg-url": "14.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.1.0"
  }
}
